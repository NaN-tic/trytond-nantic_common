<tryton>
    <data depends="account_invoice">
        <record model="ir.action.act_window" id="act_credit_notes_form">
            <field name="name">Credit Notes</field>
            <field name="res_model">account.invoice</field>
            <field name="domain"
                eval="[('lines.origin.invoice', 'in', Eval('active_ids'), 'account.invoice.line')]"
                pyson="1"/>
        </record>
        <record model="ir.action.keyword" id="act_open_credit_notes_keyword">
            <field name="keyword">form_relate</field>
            <field name="model">account.invoice,-1</field>
            <field name="action" ref="act_credit_notes_form"/>
        </record>
    </data>
</tryton>
